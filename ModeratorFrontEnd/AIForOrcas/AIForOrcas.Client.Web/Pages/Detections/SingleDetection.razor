@page "/detections/detection/{id}"

<PageTitle>Detection - @Id</PageTitle>
<PageHeadingComponent Title="Detection" />

@if (isUnavailable)
{
    <h5 class="mt-5">An unknown error occurred while loading the record...</h5>
}
else if (detection == null)
{
    <h5 class="mt-5">Loading record...</h5>
}
else if (isFound)
{
    <DetectionMinuteComponent SubmitCallback="ActOnSubmitCallback" DetectionMinute=@detectionMinute />
}
else
{
    <h5 class="mt-5">Requested Detection with ID '@Id' could not be found.</h5>
}

<LoginWarningComponent />